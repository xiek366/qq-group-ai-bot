# ============================================================
# QQ Bot 环境变量模板
# 用法：cp .env.example .env 然后按需修改（云端把这个文件放到项目根）
# ============================================================

# === OneBot / NapCat 配置 ===
ONEBOT_WS_URL=ws://127.0.0.1:3001
# HTTP 端口（发消息用）。代码默认按 WS 端口 -1 推导，一般不用改
ONEBOT_HTTP_PORT=3000
# 如果 NapCat 启用了 Access Token，在这里填写；没有就留空
# 留空时会自动去扫 NapCat 配置文件里的 token（Windows / Linux 常见路径都试）
ONEBOT_ACCESS_TOKEN=
# 指定 NapCat 配置目录（自动扫描没命中时用）
NAPCAT_CONFIG_DIR=

# === LLM 配置 ===
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
# 需要看图功能就选带视觉的模型（如 deepseek-flash）
LLM_MODEL=deepseek-chat
# 单次回复的 token 上限。思维链和正式回答共用这份预算，给小了会出现
# 「思考还没写完就被截断 → content 为空」，所以别低于 1024
LLM_MAX_TOKENS=2048
# 思考模式开关：enabled / disabled
# 注意：思考模式下 temperature 不生效（官方明确不支持），而且更慢更贵。
# 群聊场景（人设闲聊）建议 disabled；需要长推理再设 enabled
LLM_THINKING=enabled
# 思考强度：low / high / max（留空用服务端默认，通常 high）
LLM_REASONING_EFFORT=

# === 看图（视觉）配置 ===
# 看图只要一段描述，关掉思考更省更快，也能避免 content 为空（默认关）
VISION_THINKING_DISABLED=true
# 看图单次 token 上限（被截断时会自动翻倍重试一次）
VISION_MAX_TOKENS=1024
# 【P0-3】下载图片的超时（秒）
VISION_DOWNLOAD_TIMEOUT=20
# 单图超过这个大小就不内联，退回用 URL 交给模型自己下载（不引入 Pillow 做压缩）
VISION_INLINE_MAX_MB=4
# 一次请求内联的总字节上限（官方请求体上限 48MiB，留足余量）
VISION_INLINE_TOTAL_MB=12
# 图片描述缓存天数：同一张图重复发就不再请求视觉接口（0 = 不缓存）
VISION_CACHE_DAYS=30

# === 搜索配置 ===
# 搜索引擎：SearXNG（代码内置一份公共实例列表兜底，无需 API Key）
# 填了下面的地址就优先用它；留空则依次尝试内置的公共实例
SEARXNG_URL=
# 说明：老版本模板里的 SEARCH_API_KEY / SEARCH_PROVIDER 代码并不读取，已删除，别再填了

# === COLG 论坛源（bbs.colg.cn，DNF 玩家社区）===
# ⚠️ 默认关闭：COLG 挂了腾讯 EdgeOne Bot 防护，对机房 IP（云服务器）一律下发 JS 挑战，
#    httpx/curl 都拿不到真页面（TLS 伪装也无效，2026-10-19 实测）。家宽环境可开启。
# 解析器与质量闸（回复≥N 或 浏览≥M，两个都低才丢）代码保留：app/news/sources.py
NEWS_COLG_ENABLED=false
# 板块 fid 列表，留空 = 171（国服心情咖啡屋）；要加韩版资讯填 "171,170"
NEWS_COLG_FIDS=
NEWS_COLG_MIN_REPLIES=5
NEWS_COLG_MIN_VIEWS=500

# === 【图鉴型 UP 分拣】===
# 这些 B站 UP 的条目不进资讯流，专属每日一图（逗号分隔 mid；留空 = 不分拣）
# 默认是两个日更壁纸源：2024069799 萌村百科 / 64090032 难改狐言（Pixiv美图系列）
# 每日一图优先从它们取图，当天没更新时回落其它带图条目；资讯带图条目会连封面一起发
NEWS_GALLERY_MIDS=2024069799,64090032

# === 机器人配置 ===
BOT_NAME=AI助手
# 机器人自身的 QQ 号（用于判断 @机器人）
BOT_QQ=
# 开发者的 QQ 号：填了之后 Bot 就认得这个号是它的开发者（认知层，不给额外权限）
ADMIN_QQ=
# 开发者昵称/称呼（可留空，留空则提示词里只显示 QQ 号）
ADMIN_NAME=
MAX_HISTORY=20
MAX_REPLY_LENGTH=500

# === 【D15】主动/定时打扰的群范围（重要）===
# 只允许这些群收到"主动消息"：冷场破冰、主动插嘴、没 @ 也发图的自动回复。
# 被动响应（@bot、/问、/搜、/看、命令）**不受限制**，任何群都能用。
# 留空 = 所有群都会被主动打扰；建议只填实例群，测试群不要填。
PROACTIVE_GROUPS=100000004

# === 时区（云端必看）===
# 破冰的工作时间窗（ICEBREAK_WORK_START~END）和报时工具都按这个时区算。
# 阿里云等服务器默认 UTC，靠这一项纠正，不要依赖服务器本地时区。
TIMEZONE=Asia/Shanghai

# === 群友外号 ===
# 每位成员最多能设几个外号（默认 3）
ALIAS_MAX_PER_USER=3
# 注入 system prompt 的"群友称呼表"最多包含多少人（默认 15）
ALIAS_PROMPT_LIMIT=15

# === 闲聊（主动插嘴）===
# 普通消息回复概率（0-100）。15=适中，5=安静，30=活跃，0=完全不插嘴
CHAT_REPLY_CHANCE=15
# 两次主动回复的最小间隔（秒），防止刷屏
CHAT_COOLDOWN=60
# 命中任一关键词 → 100% 必定回复（逗号分隔）
CHAT_KEYWORDS=
# 命中任一关键词 → 必定忽略（逗号分隔）
CHAT_IGNORE_KEYWORDS=
# 主动回复时喂给 LLM 的最近群聊条数
CHAT_MAX_CONTEXT=5

# === 破冰（冷场自动抛话题）===
ICEBREAK_ENABLED=true
# 群安静多少分钟后触发
ICEBREAK_IDLE_MINUTES=30
# 同一群两次破冰的最小间隔（分钟）
ICEBREAK_COOLDOWN_MINUTES=60
# 后台扫描间隔（秒）
ICEBREAK_WATCH_INTERVAL=300
# 每次扫描的触发概率（0~1），避免卡点太规律
ICEBREAK_CHANCE=0.6
# 只在几点到几点之间破冰（按上面的 TIMEZONE 算，左闭右开）
ICEBREAK_WORK_START=8
ICEBREAK_WORK_END=23
# 群人数少于这个数不破冰（避免 2 人群尴尬）
ICEBREAK_MIN_GROUP_SIZE=3

# === 管理面板 ===
DASHBOARD_ENABLED=true
# 默认只监听本机：云端用 SSH 隧道（VSCode Ports / ssh -L）访问，不要暴露公网。
# 确实要公网直连再改 0.0.0.0，并且务必配强 token + 云安全组限制来源 IP。
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# 面板口令，强烈建议改成 12 位以上随机串（默认值等于没有防护）
DASHBOARD_TOKEN=change_me_to_a_long_random_string

# === 可选 ===
LOG_LEVEL=INFO
